{
    "Eventos": {
        
        "Avery1.1": {
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "La verdad que por aquí estaba todo muy tranquilo hasta que llegaste. Me has descolocado.",
                    "options": [
                        { 
                            "response": "Y más que lo vas a estar si vienes conmigo.", 
                            "gain": 1, "next": "Avery1.1.1" 
                        },
                        { 
                            "response": "Bueno, por algo se empieza.", 
                            "gain": 0, "next": "Avery1.1.2" 
                        },
                        { 
                            "response": "Perdón por haberte molestado, no era mi intencion.", 
                            "gain": -1, "next": "Avery1.1.3" 
                        }
                    ]
                }
            ]
        },
        "Avery1.1.1":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Con que estamos con ese plan..."
                }
            ]
        },
        "Avery1.1.2":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "¿Eso es todo lo que tienes para decirme?"
                }
            ]
        },
        "Avery1.1.3":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "¿Entonces para que has venido?"
                }
            ]
        },
          
        "Avery1.2": {
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Y tú, que estás muy callad@. ¿No tienes nada que decirme?",
                    "options": [
                        { 
                            "response": "...", 
                            "gain": 0, "next": "Avery1.2.1" 
                        },
                        { 
                            "response": "No estabas hablando conmigo.", 
                            "gain": -1, "next": "Avery1.2.2" 
                        },
                        { 
                            "response": "Es que ha sido verte y quedarme sin palabras.", 
                            "gain": 1, "next": "Avery1.2.3" 
                        }
                    ]
                }
            ]
        },
        "Avery1.2.1":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Muy articulado, ya veo..."
                }
            ]
        },
        "Avery1.2.2":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "¿Es que tengo que empezar siempre yo?"
                }
            ]
        },
        "Avery1.2.3":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Si sigues así, te puedo pasar esa excusita."
                }
            ]
        },
          
        "Avery2.1": {
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Volviendo a ti. Suponiendo que te doy una oportunidad, ¿Dónde me llevarías?",
                    "options": [
                        { 
                            "response": "Una cena romántica con velas.", 
                            "gain": -1, "next": "Avery2.1.1" 
                        },
                        { 
                            "response": "A conocer mi cama .", 
                            "gain": 1, "next": "Avery2.1.2"
                        },
                        { 
                            "response": "No importa el sitio con tal de estar contigo.", 
                            "gain": 0, "next": "Avery2.1.3" 
                        }
                    ]
                }
            ]
        },
        "Avery2.1.1":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Como sigas así me da diabetes"
                }
            ]
        },
        "Avery2.1.2":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Que suerte que yo no duermo."
                }
            ]
        },
        "Avery2.1.3":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Veo que no te arriesgas."
                }
            ]
        },
        "Avery2.2": {
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Si la oportunidad te la doy a ti, ¿Qué me regalarías?",
                    "options": [
                        { 
                            "response": "¿Hace falta que me envuelva también?", 
                            "gain": 1, "next": "Avery2.2.1" 
                        },
                        { 
                            "response": "Un ramo de cien flores rojas.", 
                            "gain": 0, "next": "Avery2.2.2" 
                        },
                        { 
                            "response": "Una colleción de cartas de amor", 
                            "gain": -1, "next": "Avery2.2.3" 
                        }
                    ]
                }
            ]
        },
        "Avery2.2.1":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Lo que más me gusta de un regalo es desenvolverlo."
                }
            ]
        },
        "Avery2.2.2":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Lo tradicional no es lo mío, pero buen intento."
                }
            ]
        },
        "Avery2.2.3":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "¿Y qué se supone que tengo que hacer con eso?"
                }
            ]
        },
        "Avery3.1": {
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Y mi pregunta final para ti. ¿Qué es lo que más te ha llamado la atención de mí?",
                    "options": [
                        { 
                            "response": "Al ver esa corteza, solo he querido que sea mía.", 
                            "gain": 1, "next": "Avery3.1.1"  
                        },
                        { 
                            "response": "Tu amabilidad.", 
                            "gain": -1, "next": "Avery3.1.2"  
                        },
                        { 
                            "response": "Tu forma de ser.", 
                            "gain": 0, "next": "Avery3.1.3" 
                        }
                    ]
                }
            ]
        },
        "Avery3.1.1":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Eres una persona de con buen gusto, sin duda."
                }
            ]
        },
        "Avery3.1.2":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Pues de eso no tengo mucho."
                }
            ]
        },
        "Avery3.1.3":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Gracias, supongo."
                }
            ]
        },
        "Avery3.2": {
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Última oportunidad, ¿Algo que quieras decir?",
                    "options": [
                        { 
                            "response": "Eres lo más bonito que me ha pasado.", 
                            "gain": -1, "next": "Avery3.2.1"  
                        },
                        { 
                            "response": "Dame una noche y te lo digo.", 
                            "gain": 1, "next": "Avery3.2.2"  
                        },
                        { 
                            "response": "Creo que así está bien.", 
                            "gain": 0, "next": "Avery3.2.3" 
                        }
                    ]
                }
            ]
        },
        "Avery3.2.1":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Nos conocemos de hace un rato, relajate."
                }
            ]
        },
        "Avery3.2.2":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Que sean 2, entonces."
                }
            ]
        },
        "Avery3.2.3":{
            "dialogs": [
                {},
                {
                    "character": "Avery",
                    "text": "Vale..."
                }
            ]
        },
