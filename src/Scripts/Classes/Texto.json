        "fragmento_0.3.1": {
            "dialogs": [
                {},
            { "character": "Eshe", "text": "Esa es una respuesta bastante ingenua." },
            { "character": "Eshe", "text": "No me la esperaba de ti." },
            { "character": "Shai", "text": "En situaciones así de extremas solo podemos mantener la esperanza." },
            { "character": "Shai", "text": "El momento en el que dejemos de confiar en que podemos superar esto, es el momento en el que Apofis ha ganado." },
            { "character": "Tarik", "text": "Creo que Shai tiene razón." },
            { "character": "Tarik", "text": "Solo espero que tengas razón y no se alargue mucho más." },
            { "character": "Eshe", "text": "Si eso es lo que ambos pensáis confiaré en vosotros." },
            { "character": "Eshe", "text": "Pero voy a seguir vigilando a la gente sospechosa por mi cuenta." },
            { "character": "Eshe", "text": "Y si tengo que clavarle una flecha a alguien lo haré." }
            ]
        },

        "fragmento_0.3.2": {
            "dialogs": [
            {},
            { "character": "Tarik", "text": "Lo que dices tiene sentido." },
            { "character": "Tarik", "text": "Pero es bastante desesperanzador." },
            { "character": "Eshe", "text": "Mejor tristes que muertos, hermano." },
            { "character": "Shai", "text": "Tampoco es de mi agrado dejar a gente desprotegida." },
            { "character": "Shai", "text": "Pero si no tenemos cuidado no podremos ayudar a nadie." },
            { "character": "Tarik", "text": "Bueno, si esta es la decisión de la mayoría tendré que acatarla." },
            { "character": "Tarik", "text": "Ven conmigo a la entrada Eshe." },
            { "character": "Tarik", "text": "Tú tienes mejor criterio para estas cosas." }
            ]
        }
